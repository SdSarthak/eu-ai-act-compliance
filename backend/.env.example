# Copy to .env and fill in. Never commit the .env file.

# --- Application -----------------------------------------------------------
# development | production
ENVIRONMENT=development
DEBUG=true

# --- Database --------------------------------------------------------------
# Postgres in production; SQLite works for a quick local run:
#   DATABASE_URL=sqlite:///./compliance.db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/compliance_db

# --- Auth ------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_48_BYTE_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- CORS ------------------------------------------------------------------
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Used to build the Stripe success/cancel redirect URLs.
FRONTEND_URL=http://localhost:5173

# --- Document storage ------------------------------------------------------
# Directory generated PDFs are written to. Defaults to <backend>/storage/documents.
# DOCUMENT_STORAGE_DIR=/var/lib/compliance/documents

# --- Stripe ----------------------------------------------------------------
# Leave blank to run without billing: plans and quotas still apply, but
# checkout, the customer portal and webhooks return 503.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe recurring price IDs, one per paid plan.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=
